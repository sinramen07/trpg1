	<!-- ==================== 캐릭터 상세 & 백스토리 팝업 모달 ==================== -->
	<div id="pc-modal" class="pc-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-pc-name">
		<div class="pc-modal-dialog">
			<button type="button" class="pc-modal-close" id="pc-modal-close" aria-label="팝업 닫기">✕</button>

			<div class="pc-modal-layout">
				<div class="pc-modal-portrait">
					<img id="modal-pc-img" src="" alt="" />
					<span id="modal-pc-part" class="pc-part-badge"></span>
				</div>

				<div class="pc-modal-content">
					<div class="pc-modal-header">
						<div>
							<h3 id="modal-pc-name" class="modal-name"></h3>
							<span id="modal-pc-meta" class="modal-meta"></span>
						</div>
					</div>

					<blockquote id="modal-pc-quote" class="pc-quote"></blockquote>

					<dl class="modal-detail-list">
						<div class="modal-detail-row">
							<dt>계기</dt>
							<dd>
								<strong id="modal-motive-type" class="detail-tag"></strong>
								<span id="modal-motive-desc"></span>
							</dd>
						</div>
						<div class="modal-detail-row">
							<dt>작전</dt>
							<dd>
								<strong id="modal-tactic-type" class="detail-tag"></strong>
								<span id="modal-tactic-desc"></span>
							</dd>
						</div>
						<div class="modal-detail-row">
							<dt>프레이즈 버스트</dt>
							<dd><strong id="modal-burst" class="detail-tag"></strong></dd>
						</div>
					</dl>

					<div class="modal-backstory-section">
						<span class="modal-backstory-label">BACKSTORY // 백스토리</span>
						<p id="modal-pc-backstory" class="modal-backstory-text"></p>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	// 스크롤 시 세 개의 섹션이 부드럽게 나타나는 효과 및 상단 이동 버튼 활성화
	const revealItems = document.querySelectorAll('.reveal-item');
	const scrollSections = document.querySelectorAll('.scroll-section');
	const navLinks = document.querySelectorAll('.nav-link');

	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
				}
			});
		},
		{ threshold: 0.15 }
	);

	revealItems.forEach((item) => revealObserver.observe(item));

	const sectionObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const currentId = entry.target.getAttribute('id');
					navLinks.forEach((link) => {
						link.classList.toggle('active', link.getAttribute('data-section') === currentId);
					});
				}
			});
		},
		{ rootMargin: '-35% 0px -50% 0px' }
	);

	scrollSections.forEach((section) => sectionObserver.observe(section));

	// 캐릭터 카드 클릭 시 백스토리 팝업 모달 열기/닫기
	const modal = document.getElementById('pc-modal');
	const modalCloseBtn = document.getElementById('pc-modal-close');
	const pcCards = document.querySelectorAll('.pc-card');

	const modalImg = document.getElementById('modal-pc-img') as HTMLImageElement | null;
	const modalPart = document.getElementById('modal-pc-part');
	const modalName = document.getElementById('modal-pc-name');
	const modalMeta = document.getElementById('modal-pc-meta');
	const modalQuote = document.getElementById('modal-pc-quote');
	const modalMotiveType = document.getElementById('modal-motive-type');
	const modalMotiveDesc = document.getElementById('modal-motive-desc');
	const modalTacticType = document.getElementById('modal-tactic-type');
	const modalTacticDesc = document.getElementById('modal-tactic-desc');
	const modalBurst = document.getElementById('modal-burst');
	const modalBackstory = document.getElementById('modal-pc-backstory');

	function openPcModal(card: Element) {
		const name = card.getAttribute('data-pc-name') || '';
		const kanji = card.getAttribute('data-pc-kanji') || '';
		const part = card.getAttribute('data-pc-part') || '';
		const meta = card.getAttribute('data-pc-meta') || '';
		const img = card.getAttribute('data-pc-img') || '';
		const quote = card.getAttribute('data-pc-quote') || '';
		const motiveType = card.getAttribute('data-pc-motive-type') || '';
		const motiveDesc = card.getAttribute('data-pc-motive-desc') || '';
		const tacticType = card.getAttribute('data-pc-tactic-type') || '';
		const tacticDesc = card.getAttribute('data-pc-tactic-desc') || '';
		const burst = card.getAttribute('data-pc-burst') || '';
		const backstory = card.getAttribute('data-pc-backstory') || '';

		if (modalImg) {
			modalImg.src = img;
			modalImg.alt = name;
		}
		if (modalPart) modalPart.textContent = part;
		if (modalName) {
			modalName.innerHTML = kanji ? `${name} <span class="kanji-sub">${kanji}</span>` : name;
		}
		if (modalMeta) modalMeta.textContent = meta;
		if (modalQuote) modalQuote.textContent = quote;
		if (modalMotiveType) modalMotiveType.textContent = motiveType;
		if (modalMotiveDesc) modalMotiveDesc.textContent = motiveDesc ? `— ${motiveDesc}` : '';
		if (modalTacticType) modalTacticType.textContent = tacticType;
		if (modalTacticDesc) modalTacticDesc.textContent = tacticDesc ? `— ${tacticDesc}` : '';
		if (modalBurst) modalBurst.textContent = burst;
		if (modalBackstory) modalBackstory.textContent = backstory;

		if (modal) {
			modal.classList.add('is-open');
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		}
	}

	function closePcModal() {
		if (modal) {
			modal.classList.remove('is-open');
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		}
	}

	pcCards.forEach((card) => {
		card.addEventListener('click', () => openPcModal(card));
		card.addEventListener('keydown', (e) => {
			const keyEvent = e as KeyboardEvent;
			if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
				keyEvent.preventDefault();
				openPcModal(card);
			}
		});
	});

	modalCloseBtn?.addEventListener('click', closePcModal);
	modal?.addEventListener('click', (e) => {
		if (e.target === modal) closePcModal();
	});
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
			closePcModal();
		}
	});

	// ==================== 시나리오 인트로 오버레이 & YouTube BGM 안정 재생 & 유성우 시퀀스 연동 ====================
	const scenarioOverlay = document.getElementById('scenario-intro-overlay');
	const typingTextEl = document.getElementById('overlay-typing-text');
	const promptTextEl = document.getElementById('overlay-prompt-text');
	const introSequence = document.getElementById('intro-sequence');

	const muteBtn = document.getElementById('bgm-mute-btn');
	const muteLabel = document.getElementById('bgm-mute-label');
	const BGM_STEADY_VOLUME = 60; // 일정한 볼륨 0.6 (YouTube IFrame API 기준 60)
	let ytPlayer: any = null;
	let isPlayerReady = false;
	let isMuted = false;
	let bgmTriggeredByUser = false;

	function updateMuteUI() {
		if (!muteBtn || !muteLabel) return;
		muteBtn.classList.toggle('is-muted', isMuted);
		muteLabel.textContent = isMuted ? 'MUTE' : 'BGM ON';
	}

	// 볼륨 타이머(setInterval) 없이 클릭 즉시 일정한 볼륨(0.6 / 60)으로 안정 재생
	function startBgmPlayback() {
		if (!ytPlayer || !isPlayerReady) return;
		try {
			ytPlayer.setVolume?.(BGM_STEADY_VOLUME);
			if (isMuted) {
				ytPlayer.mute?.();
			} else {
				ytPlayer.unMute?.();
			}
			ytPlayer.playVideo?.();
		} catch {
			// YouTube IFrame API 예외 무시
		}
	}

	// YouTube IFrame Player API 로드 (클릭 전 미리 준비)
	const tag = document.createElement('script');
	tag.src = 'https://www.youtube.com/iframe_api';
	document.head.appendChild(tag);

	(window as any).onYouTubeIframeAPIReady = () => {
		ytPlayer = new (window as any).YT.Player('yt-bgm-player', {
			width: '1',
			height: '1',
			videoId: 'XogSflwXgpw',
			playerVars: {
				autoplay: 0,
				loop: 1,
				playlist: 'XogSflwXgpw',
				controls: 0,
				disablekb: 1,
				fs: 0,
				modestbranding: 1,
				playsinline: 1,
			},
			events: {
				onReady: (event: any) => {
					isPlayerReady = true;
					event.target.setVolume(BGM_STEADY_VOLUME);
					// 사용자가 API 로드 완료 전에 이미 오버레이를 클릭했다면 즉시 일정 볼륨(60)으로 재생
					if (bgmTriggeredByUser) {
						startBgmPlayback();
					}
				},
				onStateChange: (event: any) => {
					// YT.PlayerState: ENDED(0), PLAYING(1), PAUSED(2)
					if (!bgmTriggeredByUser) return;
					if (event.data === 0) {
						// 트랙 종료 시 끊김 없이 루프 재생 보장
						event.target.playVideo?.();
					} else if (event.data === 1 && !isMuted) {
						// 재생 중 볼륨이 줄어들거나 음소거되지 않도록 일정 볼륨(60) 유지
						event.target.unMute?.();
						event.target.setVolume?.(BGM_STEADY_VOLUME);
					} else if (event.data === 2 && !isMuted) {
						// 오버레이/인트로 DOM 제거 시점에 의도치 않게 일시정지되면 즉시 재개
						event.target.playVideo?.();
					}
				},
			},
		});
	};

	muteBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		isMuted = !isMuted;
		updateMuteUI();
		if (!ytPlayer || !isPlayerReady) return;
		if (isMuted) {
			ytPlayer.mute?.();
		} else {
			bgmTriggeredByUser = true;
			ytPlayer.unMute?.();
			ytPlayer.setVolume?.(BGM_STEADY_VOLUME);
			ytPlayer.playVideo?.();
		}
	});

	// 1) "너는 알고 있을까?" 감성 타이핑 + 페이드인 연출 후 "밤하늘 올려다보기" Pulse 노출
	const introPhrase = '너는 알고 있을까?';
	if (scenarioOverlay && typingTextEl) {
		document.body.style.overflow = 'hidden';

		const chars = Array.from(introPhrase);
		const startDelay = 420;
		const charInterval = 115;

		chars.forEach((ch, idx) => {
			const span = document.createElement('span');
			span.className = 'overlay-char';
			span.textContent = ch === ' ' ? '\u00A0' : ch;
			span.style.animationDelay = `${startDelay + idx * charInterval}ms`;
			typingTextEl.appendChild(span);
		});

		const totalTypingTime = startDelay + chars.length * charInterval + 350;
		window.setTimeout(() => {
			promptTextEl?.classList.add('is-visible');
		}, totalTypingTime);
	}

	// 2) 오버레이 클릭 시: 일정 볼륨(0.6)으로 BGM 즉시 재생 + 오버레이 Blur & Fade-out 후 DOM 제거 + 유성우 연출 실행
	let isOverlayDismissed = false;
	function dismissScenarioOverlay() {
		if (isOverlayDismissed) return;
		isOverlayDismissed = true;

		// 사용자 클릭 제스처 시점에 즉시 일정한 볼륨(0.6 / 60)으로 BGM 재생 시작
		bgmTriggeredByUser = true;
		startBgmPlayback();

		// 오버레이 Blur + Fade-out 전환 후 DOM에서 완전 제거 (BGM은 계속 유지)
		if (scenarioOverlay) {
			scenarioOverlay.classList.add('is-fading-out');
			window.setTimeout(() => {
				scenarioOverlay.remove();
				if (!isMuted) startBgmPlayback();
			}, 750);
		}

		// 오버레이가 사라지기 시작하면서 기존 유성우 인트로 시퀀스(2.5초) 재생 및 메인 페이지 연결
		if (introSequence) {
			introSequence.classList.add('is-playing');
			window.setTimeout(() => {
				introSequence.classList.add('is-finished');
				document.body.style.overflow = '';
				window.setTimeout(() => {
					introSequence.remove();
					if (!isMuted) startBgmPlayback();
				}, 150);
			}, 2500);
		} else {
			document.body.style.overflow = '';
		}
	}

	scenarioOverlay?.addEventListener('click', dismissScenarioOverlay);
	scenarioOverlay?.addEventListener('keydown', (e) => {
		const keyEvent = e as KeyboardEvent;
		if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
			keyEvent.preventDefault();
			dismissScenarioOverlay();
		}
	});
</script>

<style>
	/* ==================== 0. 감성 시나리오 인트로 오버레이 (순수 CSS & JS) ==================== */
	.scenario-intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		cursor: pointer;
		user-select: none;
		background:
			radial-gradient(ellipse 85% 65% at 50% 42%, #11192e 0%, #0a0e1a 58%, #060912 100%);
		transition:
			opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
			filter 0.75s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.scenario-intro-overlay.is-fading-out {
		opacity: 0;
		filter: blur(18px);
		transform: scale(1.03);
		pointer-events: none;
	}

	/* 미세하게 반짝이는 별빛 파티클 배경 */
	.overlay-starfield {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.overlay-micro-star {
		position: absolute;
		border-radius: 50%;
		background: #e2f1ff;
		box-shadow: 0 0 6px rgba(148, 216, 255, 0.65);
		opacity: 0.12;
		animation: overlay-star-twinkle var(--o-dur, 3.2s) ease-in-out var(--o-delay, 0s) infinite alternate;
	}

	@keyframes overlay-star-twinkle {
		0% {
			opacity: 0.08;
			transform: scale(0.85);
		}
		100% {
			opacity: var(--o-max, 0.65);
			transform: scale(1.15);
		}
	}

	/* 중앙 문구 및 안내 텍스트 레이아웃 */
	.overlay-center-box {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2.2rem;
		padding: 2rem;
		text-align: center;
	}

	.overlay-main-phrase {
		margin: 0;
		min-height: 1.5em;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 3.6vw, 2.45rem);
		font-weight: normal;
		letter-spacing: 0.12em;
		color: #f8fafc;
		text-shadow:
			0 0 22px rgba(96, 224, 255, 0.38),
			0 2px 14px rgba(0, 0, 0, 0.75);
	}

	/* JS로 동적 생성되는 글자별 타이핑 + 서서히 페이드인 효과 */
	:global(.overlay-char) {
		display: inline-block;
		opacity: 0;
		filter: blur(6px);
		transform: translateY(6px);
		animation: overlay-char-appear 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	@keyframes overlay-char-appear {
		0% {
			opacity: 0;
			filter: blur(6px);
			transform: translateY(6px);
		}
		100% {
			opacity: 1;
			filter: blur(0px);
			transform: translateY(0);
		}
	}

	/* 문구 출력 완료 후 숨쉬듯 깜빡이는(Pulse) 안내 텍스트 */
	.overlay-pulse-prompt {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: clamp(0.88rem, 1.5vw, 1.02rem);
		font-weight: 400;
		letter-spacing: 0.24em;
		padding-left: 0.24em;
		color: rgba(186, 230, 253, 0.85);
		text-shadow: 0 0 14px rgba(96, 224, 255, 0.45);
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.8s ease,
			transform 0.8s ease;
	}

	.overlay-pulse-prompt.is-visible {
		opacity: 0.85;
		transform: translateY(0);
		animation: overlay-prompt-pulse 2.6s ease-in-out 0.8s infinite;
	}

	@keyframes overlay-prompt-pulse {
		0%,
		100% {
			opacity: 0.85;
			text-shadow: 0 0 16px rgba(96, 224, 255, 0.55);
		}
		50% {
			opacity: 0.28;
			text-shadow: 0 0 6px rgba(96, 224, 255, 0.15);
		}
	}

	/* ==================== 페이지 진입 유성우 인트로 시퀀스 (오버레이 클릭 후 총 2.5s) ====================
	   타임라인 (.is-playing 활성화 시점 기준):
	   - 0.15s ~ 0.65s: 밤하늘에 첫 번째 단일 유성(Lead Meteor)이 길게 떨어짐
	   - 0.65s ~ 1.20s: 첫 유성 낙하 후 여운을 남기는 정적 간격 (약 0.55s)
	   - 1.20s ~ 2.20s: 이어서 여러 개의 유성우(Meteor Shower)가 쏟아짐
	   - 2.10s ~ 2.50s: 유성우와 함께 첫 화면으로 부드럽게 전환
	*/
	.intro-sequence {
		position: fixed;
		inset: 0;
		z-index: 9999;
		overflow: hidden;
		background: #050814;
		pointer-events: none;
	}

	.intro-sequence.is-playing {
		animation: intro-fade-out 0.4s ease-out 2.1s forwards;
	}

	.intro-sequence.is-finished {
		opacity: 0;
		visibility: hidden;
	}

	@keyframes intro-fade-out {
		0% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	.intro-sky-shot {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 35%, rgba(36, 72, 138, 0.42) 0%, rgba(10, 15, 32, 0.94) 60%, #060914 100%);
	}

	.intro-stars-bg {
		position: absolute;
		inset: 0;
		background-image:
			radial-gradient(1.5px 1.5px at 18% 24%, #ffffff, transparent),
			radial-gradient(1.2px 1.2px at 34% 14%, #bae6fd, transparent),
			radial-gradient(1.5px 1.5px at 56% 28%, #fde68a, transparent),
			radial-gradient(1.2px 1.2px at 76% 19%, #ffffff, transparent),
			radial-gradient(1.8px 1.8px at 84% 42%, #60e0ff, transparent),
			radial-gradient(1px 1px at 25% 58%, #ffffff, transparent),
			radial-gradient(1.4px 1.4px at 64% 62%, #bae6fd, transparent),
			radial-gradient(1.2px 1.2px at 45% 48%, #ffffff, transparent);
	}

	/* 1) 오버레이 해제 직후(0.15s~0.65s) 떨어지는 첫 번째 단일 유성 */
	.intro-lead-meteor {
		position: absolute;
		top: 6%;
		left: 72%;
		width: 280px;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, #ffffff 0%, #60e0ff 38%, rgba(56, 189, 248, 0.4) 70%, transparent 100%);
		box-shadow:
			0 0 18px 3px rgba(96, 224, 255, 0.95),
			0 0 36px 6px rgba(56, 189, 248, 0.55);
		opacity: 0;
		transform: rotate(-35deg) translate3d(120px, -80px, 0);
		will-change: transform, opacity;
	}

	.intro-sequence.is-playing .intro-lead-meteor {
		animation: lead-meteor-fall 0.5s cubic-bezier(0.25, 0.8, 0.4, 1) 0.15s forwards;
	}

	.intro-lead-meteor::before {
		content: '';
		position: absolute;
		left: -4px;
		top: 50%;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #ffffff;
		transform: translateY(-50%);
		box-shadow: 0 0 20px 6px #ffffff, 0 0 32px 10px #60e0ff;
	}

	@keyframes lead-meteor-fall {
		0% {
			opacity: 0;
			transform: rotate(-35deg) translate3d(140px, 0, 0) scaleX(0.4);
		}
		20% {
			opacity: 1;
			transform: rotate(-35deg) translate3d(40px, 0, 0) scaleX(1.1);
		}
		85% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: rotate(-35deg) translate3d(-620px, 0, 0) scaleX(0.9);
		}
	}

	/* 2) 첫 유성 후 정적 간격 뒤(1.20s~) 쏟아지는 다수의 유성우 */
	.intro-meteor-shower {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.shower-meteor {
		position: absolute;
		height: 2px;
		border-radius: 999px;
		background: linear-gradient(90deg, #ffffff 0%, #8ed5ff 35%, rgba(253, 230, 138, 0.45) 68%, transparent 100%);
		box-shadow: 0 0 12px 2px rgba(96, 224, 255, 0.8);
		opacity: 0;
		transform: rotate(-35deg) translate3d(100px, 0, 0);
		will-change: transform, opacity;
	}

	.intro-sequence.is-playing .shower-meteor {
		animation: shower-meteor-fall var(--m-dur, 0.52s) ease-in var(--m-delay, 1.2s) forwards;
	}

	.shower-meteor::before {
		content: '';
		position: absolute;
		left: -2px;
		top: 50%;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #ffffff;
		transform: translateY(-50%);
		box-shadow: 0 0 10px 3px #60e0ff;
	}

	@keyframes shower-meteor-fall {
		0% {
			opacity: 0;
			transform: rotate(-35deg) translate3d(120px, 0, 0);
		}
		20% {
			opacity: 1;
		}
		85% {
			opacity: 0.95;
		}
		100% {
			opacity: 0;
			transform: rotate(-35deg) translate3d(-680px, 0, 0);
		}
	}

	/* 유튜브 영상 화면은 숨기고 음원만 출력 */
	.yt-audio-hidden {
		position: fixed;
		width: 1px;
		height: 1px;
		bottom: -10px;
		left: -10px;
		opacity: 0.001;
		pointer-events: none;
		overflow: hidden;
		z-index: -1;
	}

	/* ==================== 상단 네비게이션 ==================== */
	.top-bar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: var(--nav-height);
		background: rgba(8, 11, 22, 0.78);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(96, 224, 255, 0.15);
		z-index: 100;
	}

	.top-bar-inner {
		max-width: 1120px;
		height: 100%;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.top-left-group {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.bgm-mute-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.7rem;
		border-radius: var(--radius-full);
		background: rgba(56, 189, 248, 0.14);
		border: 1px solid rgba(96, 224, 255, 0.38);
		color: var(--tertiary);
		font-family: var(--font-serif);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		cursor: pointer;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.bgm-mute-btn:hover {
		background: rgba(56, 189, 248, 0.24);
		box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
	}

	.bgm-mute-btn .icon-sound-off {
		display: none;
	}

	.bgm-mute-btn.is-muted {
		background: rgba(100, 116, 139, 0.18);
		border-color: rgba(148, 163, 184, 0.35);
		color: var(--text-muted);
	}

	.bgm-mute-btn.is-muted .icon-sound-on {
		display: none;
	}

	.bgm-mute-btn.is-muted .icon-sound-off {
		display: inline-block;
	}

	.brand-title {
		font-family: var(--font-headline);
		font-weight: 700;
		font-size: 1.08rem;
		color: var(--text-white);
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.section-nav {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.nav-link {
		font-family: var(--font-serif);
		padding: 0.4rem 0.9rem;
		border-radius: var(--radius-default);
		font-size: 0.88rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--text-body);
		border: 1px solid transparent;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: var(--text-white);
		background: rgba(56, 189, 248, 0.12);
	}

	.nav-link.active {
		color: var(--tertiary);
		background: rgba(56, 189, 248, 0.16);
		border-color: rgba(96, 224, 255, 0.4);
		box-shadow: 0 0 14px rgba(56, 189, 248, 0.25);
	}

	/* ==================== 첫 화면: 별빛 반짝임 강조 + 헤더.png ==================== */
	.first-screen {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: calc(var(--nav-height) + 2rem) 1.5rem 3rem;
		overflow: hidden;
	}

	.starlight-sky {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 50% 30%, rgba(30, 64, 124, 0.35) 0%, rgba(11, 17, 36, 0.9) 55%, #080b16 100%);
	}

	.nebula-glow {
		position: absolute;
		inset: -10%;
		background:
			radial-gradient(ellipse 45% 30% at 62% 28%, rgba(56, 189, 248, 0.18), transparent 70%),
			radial-gradient(ellipse 35% 25% at 35% 65%, rgba(253, 230, 138, 0.08), transparent 70%);
		filter: blur(24px);
	}

	.orbit-line {
		position: absolute;
		left: 50%;
		top: 50%;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		border: 1px dashed rgba(96, 224, 255, 0.12);
	}

	.orbit-1 {
		width: 640px;
		height: 640px;
	}

	.orbit-2 {
		width: 980px;
		height: 980px;
		border-style: solid;
		border-color: rgba(96, 224, 255, 0.06);
	}

	/* 별빛 반짝임 애니메이션 */
	.twinkle-star {
		position: absolute;
		border-radius: 50%;
		background: var(--star-color, #ffffff);
		box-shadow: 0 0 8px 1px var(--star-color, #ffffff);
		opacity: 0.2;
		animation: star-twinkle var(--duration, 3s) ease-in-out var(--delay, 0s) infinite alternate;
	}

	@keyframes star-twinkle {
		0% {
			opacity: 0.15;
			transform: scale(0.75);
		}
		50% {
			opacity: 0.95;
			transform: scale(1.35);
			box-shadow: 0 0 12px 2px var(--star-color, #ffffff);
		}
		100% {
			opacity: 0.3;
			transform: scale(0.9);
		}
	}

	/* 별똥별 연출 */
	.shooting-star {
		position: absolute;
		width: 110px;
		height: 1.5px;
		background: linear-gradient(90deg, rgba(96, 224, 255, 0.95), transparent);
		opacity: 0;
		transform: rotate(-32deg);
		animation: shoot 9s ease-in-out infinite;
	}

	.shooting-star.s1 {
		top: 18%;
		right: 15%;
		animation-delay: 1.5s;
	}

	.shooting-star.s2 {
		top: 36%;
		left: 18%;
		animation-delay: 5.5s;
	}

	@keyframes shoot {
		0%,
		88%,
		100% {
			opacity: 0;
			transform: translate(0, 0) rotate(-32deg);
		}
		90% {
			opacity: 1;
		}
		95% {
			opacity: 0;
			transform: translate(-180px, 112px) rotate(-32deg);
		}
	}

	.hero-center {
		position: relative;
		z-index: 1;
		max-width: 820px;
		width: 100%;
		text-align: center;
	}

	.scenario-meta {
		font-family: var(--font-serif);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		color: var(--tertiary);
		margin: 0 0 0.75rem;
	}

	.main-title {
		font-family: var(--font-headline);
		font-size: clamp(2.35rem, 5.2vw, 3.7rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		margin: 0 0 1.15rem;
		color: var(--text-white);
		text-shadow:
			0 2px 18px rgba(56, 189, 248, 0.4),
			0 0 36px rgba(96, 224, 255, 0.22);
	}

	.hero-quote {
		font-family: var(--font-serif);
		font-size: clamp(0.96rem, 1.85vw, 1.12rem);
		color: var(--text-body);
		line-height: 1.95;
		letter-spacing: 0.02em;
		margin: 0 auto 1.85rem;
	}

	.header-image-frame {
		margin: 0 auto 2rem;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid rgba(96, 224, 255, 0.35);
		box-shadow: 0 0 32px -4px rgba(56, 189, 248, 0.3);
		background: #080b16;
	}

	.header-img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.scroll-indicator {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-family: var(--font-serif);
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		color: var(--primary-light);
		opacity: 0.85;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.scroll-indicator:hover {
		opacity: 1;
		transform: translateY(3px);
	}

	/* ==================== 3개 스크롤 섹션 ==================== */
	.scroll-section {
		position: relative;
		z-index: 1;
		padding: 5.5rem 1.5rem;
		max-width: 920px;
		margin: 0 auto;
	}

	.section-header {
		margin-bottom: 1.5rem;
	}

	.section-index {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--tertiary);
		margin-bottom: 0.4rem;
	}

	.section-title {
		font-family: var(--font-headline);
		font-size: clamp(1.6rem, 3.2vw, 2.15rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		margin: 0;
		color: var(--text-white);
	}

	.synopsis-panel {
		background: rgba(16, 26, 56, 0.45);
		backdrop-filter: blur(16px);
		border: 1px solid rgba(96, 224, 255, 0.2);
		border-radius: var(--radius-lg);
		padding: 2.25rem 2.2rem;
	}

	.synopsis-label {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		padding: 0.24rem 0.75rem;
		border-radius: var(--radius-full);
		background: rgba(56, 189, 248, 0.14);
		border: 1px solid rgba(96, 224, 255, 0.35);
		color: var(--tertiary);
		margin-bottom: 1.25rem;
	}

	.synopsis-content {
		font-family: var(--font-body);
		font-size: 1.04rem;
		line-height: 1.95;
		letter-spacing: 0.015em;
		color: var(--text-body);
	}

	.synopsis-content p {
		margin: 0;
	}

	.synopsis-quote {
		margin: 1.35rem 0;
		padding: 0.65rem 0 0.65rem 1.2rem;
		border-left: 2px solid var(--tertiary);
		font-family: var(--font-serif);
		font-size: 1.08rem;
		color: var(--text-white);
		line-height: 1.95;
		letter-spacing: 0.02em;
	}

	/* NPC 소개 카드 */
	.npc-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.npc-card {
		background: rgba(16, 26, 56, 0.45);
		backdrop-filter: blur(16px);
		border: 1px solid rgba(96, 224, 255, 0.22);
		border-radius: var(--radius-lg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.npc-portrait-wrap {
		width: 100%;
		aspect-ratio: 4 / 4.5;
		background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
		border-bottom: 1px solid rgba(96, 224, 255, 0.2);
		overflow: hidden;
	}

	.npc-portrait-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	.npc-body {
		padding: 1.75rem 1.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		flex: 1;
	}

	.npc-card-header {
		padding-bottom: 0.85rem;
		border-bottom: 1px solid rgba(96, 224, 255, 0.14);
	}

	.npc-role-badge {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-full);
		background: rgba(253, 230, 138, 0.14);
		border: 1px solid rgba(253, 230, 138, 0.35);
		color: var(--secondary-light);
		margin-bottom: 0.55rem;
	}

	.npc-name {
