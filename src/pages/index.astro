---
import Layout from '../layouts/Layout.astro';

// 첫 화면 별빛 반짝임 파티클 생성 데이터
const stars = Array.from({ length: 85 }, (_, i) => ({
	left: `${(i * 37 + 13) % 100}%`,
	top: `${(i * 53 + 7) % 100}%`,
	size: (i % 3) + 1.5,
	delay: `${((i * 7) % 50) / 10}s`,
	duration: `${2.2 + ((i * 11) % 35) / 10}s`,
	color: i % 7 === 0 ? '#60e0ff' : i % 11 === 0 ? '#fde68a' : '#f8fafc',
}));

// 시나리오 인트로 오버레이용 미세 별빛 파티클 데이터 (순수 CSS)
const overlayStars = Array.from({ length: 70 }, (_, i) => ({
	left: `${(i * 41 + 9) % 100}%`,
	top: `${(i * 59 + 11) % 100}%`,
	size: (i % 2) + 1,
	delay: `${((i * 9) % 45) / 10}s`,
	duration: `${2.6 + ((i * 13) % 30) / 10}s`,
	opacity: (0.25 + ((i * 7) % 55) / 100).toFixed(2),
}));

// 인트로 유성우 다발(첫 유성이 떨어지고 간격을 둔 뒤 1.20s부터 쏟아지는 유성우) 데이터
const meteorShower = Array.from({ length: 18 }, (_, i) => ({
	left: `${18 + ((i * 17) % 80)}%`,
	top: `${-10 + ((i * 13) % 45)}%`,
	delay: `${1.2 + (i % 7) * 0.08}s`,
	duration: `${0.52 + (i % 3) * 0.08}s`,
	length: `${150 + (i % 4) * 45}px`,
}));
---

<Layout>
	<!-- ==================== 0. 감성 시나리오 인트로 오버레이 (순수 CSS & JS) ==================== -->
	<div
		id="scenario-intro-overlay"
		class="scenario-intro-overlay"
		role="button"
		tabindex="0"
		aria-label="밤하늘 올려다보기 - 클릭하여 시나리오 진입"
	>
		<!-- 미세하게 반짝이는 밤하늘 별빛 파티클 배경 -->
		<div class="overlay-starfield" aria-hidden="true">
			{
				overlayStars.map((s) => (
					<span
						class="overlay-micro-star"
						style={`left:${s.left}; top:${s.top}; width:${s.size}px; height:${s.size}px; --o-delay:${s.delay}; --o-dur:${s.duration}; --o-max:${s.opacity};`}
					/>
				))
			}
		</div>

		<!-- 중앙 감성 문구 및 Pulse 안내 텍스트 -->
		<div class="overlay-center-box">
			<p id="overlay-typing-text" class="overlay-main-phrase" aria-live="polite"></p>
			<span id="overlay-prompt-text" class="overlay-pulse-prompt">밤하늘 올려다보기</span>
		</div>
	</div>

	<!-- ==================== 페이지 진입 유성우 인트로 시퀀스 (오버레이 클릭 직후 2.5초 재생) ==================== -->
	<div id="intro-sequence" class="intro-sequence" aria-hidden="true">
		<div class="intro-sky-shot">
			<div class="intro-stars-bg"></div>

			<!-- 1) 첫 번째 단일 유성 -->
			<span class="intro-lead-meteor"></span>

			<!-- 2) 간격을 두고 이어서 쏟아지는 다수의 유성우 -->
			<div class="intro-meteor-shower">
				{
					meteorShower.map((m) => (
						<span
							class="shower-meteor"
							style={`left:${m.left}; top:${m.top}; width:${m.length}; --m-delay:${m.delay}; --m-dur:${m.duration};`}
						/>
					))
				}
			</div>
		</div>
	</div>

	<!-- 배경음악(YouTube 음원) 히든 플레이어 -->
	<div class="yt-audio-hidden" aria-hidden="true">
		<div id="yt-bgm-player"></div>
	</div>

	<!-- 상단 네비게이션 (왼쪽 상단 음소거 버튼 + 섹션 이동 버튼) -->
	<header class="top-bar">
		<div class="top-bar-inner">
			<div class="top-left-group">
				<button
					type="button"
					id="bgm-mute-btn"
					class="bgm-mute-btn"
					aria-label="배경음악 음소거 전환"
					title="배경음악 켜기 / 음소거"
				>
					<!-- 음소거 해제(재생 중) 아이콘 -->
					<svg class="icon-sound-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
						<path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
						<path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
					</svg>
					<!-- 음소거 상태 아이콘 -->
					<svg class="icon-sound-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
						<line x1="23" y1="9" x2="17" y2="15"></line>
						<line x1="17" y1="9" x2="23" y2="15"></line>
					</svg>
					<span id="bgm-mute-label" class="bgm-mute-label">BGM ON</span>
				</button>
				<a href="#top" class="brand-title">너를 공전하고 싶어</a>
			</div>

			<nav class="section-nav" aria-label="섹션 이동 메뉴">
				<a href="#overview" class="nav-link" data-section="overview">시나리오 개요</a>
				<a href="#npc" class="nav-link" data-section="npc">NPC 소개</a>
				<a href="#character" class="nav-link" data-section="character">캐릭터 소개</a>
			</nav>
		</div>
	</header>

	<main id="top">
		<!-- ==================== 스크롤 이전 첫 화면: 별빛 반짝임 강조 배경 + 헤더.png ==================== -->
		<section class="first-screen">
			<!-- 반짝이는 별빛 배경 레이어 -->
			<div class="starlight-sky" aria-hidden="true">
				<div class="nebula-glow"></div>
				<div class="orbit-line orbit-1"></div>
				<div class="orbit-line orbit-2"></div>
				{
					stars.map((star) => (
						<span
							class="twinkle-star"
							style={`left:${star.left}; top:${star.top}; width:${star.size}px; height:${star.size}px; --delay:${star.delay}; --duration:${star.duration}; --star-color:${star.color};`}
						/>
					))
				}
				<span class="shooting-star s1"></span>
				<span class="shooting-star s2"></span>
			</div>

			<!-- 중앙 타이틀 & 헤더.png -->
			<div class="hero-center">
				<p class="scenario-meta">STRATO SHOUT TRPG SCENARIO · W. 두기</p>
				<h1 class="main-title">너를 공전하고 싶어</h1>
				<p class="hero-quote">
					“천체망원경으로 별을 보는 것을 좋아하는 너.<br />
					네가 별을 좋아하는 것처럼 너를 좋아하는 사람이 있다는 걸, 너는 알고 있을까?”
				</p>

				<figure class="header-image-frame">
					<img src="/헤더.png" alt="너를 공전하고 싶어 - 스트라토 샤우트 시나리오 W. 두기" class="header-img" />
				</figure>

				<a href="#overview" class="scroll-indicator">
					<span>SCROLL</span>
					<span class="scroll-arrow">↓</span>
				</a>
			</div>
		</section>

		<!-- ==================== 1. 시나리오 개요 ==================== -->
		<section id="overview" class="scroll-section reveal-item">
			<div class="section-inner">
				<div class="section-header">
					<span class="section-index">01 // OVERVIEW</span>
					<h2 class="section-title">시나리오 개요</h2>
				</div>

				<div class="synopsis-panel">
					<span class="synopsis-label">시놉시스</span>
					<div class="synopsis-content">
						<p>어느 날, 한 명의 소년이 여러분들에게 부탁을 합니다.</p>
						<blockquote class="synopsis-quote">
							“별이나 달… 아니면 뭔가 우주나 천문학적인 아무거나라도 좋으니까, 그런 것에 관한 노래를 공연해 줄 수 있어? 동아리 이벤트를 계획하고 있거든.”
						</blockquote>
						<p>여러분들은 소년의 의뢰를 성공시킬 수 있을까요?</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ==================== 2. NPC 소개 ==================== -->
		<section id="npc" class="scroll-section reveal-item">
			<div class="section-inner">
				<div class="section-header">
					<span class="section-index">02 // NPC</span>
					<h2 class="section-title">NPC 소개</h2>
				</div>

				<div class="npc-grid">
					<!-- NPC 1: 이부키 마와루 -->
					<article class="npc-card">
						<div class="npc-portrait-wrap">
							<img src="/npc-mawaru.png" alt="이부키 마와루" class="npc-portrait-img" loading="lazy" />
						</div>
						<div class="npc-body">
							<div class="npc-card-header">
								<span class="npc-role-badge">의뢰인 · 천문학 동아리 부장</span>
								<h3 class="npc-name">이부키 마와루</h3>
							</div>
							<p class="npc-desc">
								고등학교 천문학 동아리의 부장이자 이번 공연을 부탁한 의뢰인입니다. 하늘의 별을 보는 취미를 가지고 있으며, 천문과학관 및 천문대 근처 버스킹 존에서 진행될 동아리 이벤트를 계획하고 있습니다.
							</p>
							<p class="npc-desc">
								상당히 소심하고 내성적인 성격이라 타인들과 눈을 잘 마주치지 못하고 쭈뼛거리는 편이지만, 내면에는 사려 깊고 배려심 있는 면모를 가지고 있습니다.
							</p>
						</div>
					</article>

					<!-- NPC 2: 호시노 아카리 -->
					<article class="npc-card">
						<div class="npc-portrait-wrap">
							<img src="/npc-akari.png" alt="호시노 아카리" class="npc-portrait-img" loading="lazy" />
						</div>
						<div class="npc-body">
							<div class="npc-card-header">
								<span class="npc-role-badge">천문학 동아리 부원</span>
								<h3 class="npc-name">호시노 아카리</h3>
							</div>
							<p class="npc-desc">
								천문학 동아리에 소속된 여학생입니다. 별과 달, 그리고 천체망원경으로 밤하늘의 별을 관측하는 것을 좋아하며, 대학교에 진학해 천문학을 전공하고 관련 직업을 얻는 것을 꿈꾸고 있습니다.
							</p>
							<p class="npc-desc">
								외향적이기보다는 얌전한 인상이지만 상냥하고 따스한 성격을 지녔으며, 자신의 의지와 결단대로 나아가는 고고한 별 같은 면모가 있습니다.
							</p>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- ==================== 3. 캐릭터 소개 ==================== -->
		<section id="character" class="scroll-section reveal-item">
			<div class="section-inner">
				<div class="section-header">
					<span class="section-index">03 // CHARACTER</span>
					<h2 class="section-title">캐릭터 소개</h2>
					<p class="section-sub-hint">캐릭터 카드를 클릭하면 백스토리와 상세 설정을 팝업에서 확인할 수 있습니다.</p>
				</div>

				<div class="pc-grid">
					<!-- 1. 쿠루미 코토네 (정효민) -->
					<article
						class="pc-card"
						role="button"
						tabindex="0"
						data-pc-name="쿠루미 코토네"
						data-pc-kanji=""
						data-pc-part="보컬 · Vo."
						data-pc-meta="여 · 17세 · PL 정효민"
						data-pc-img="/pc-정효민.png"
						data-pc-quote="“어...응”"
						data-pc-motive-type="기연"
						data-pc-motive-desc="밴드부 연주를 듣고 감명받아 가입"
						data-pc-tactic-type="이모션"
						data-pc-tactic-desc="불안 분노 사랑"
						data-pc-burst="천창 : Strato Shout"
						data-pc-backstory="친구없는 아싸찐따 히키코모리 쿠루미 코토네는 존재감이 전혀 없는 친구이다. 그녀는 머리를 자르러 가는 것 또한 힘들어하여서 머리를 안 자른지 몇 년이 지날 정도로 사람들과 대화를 어려워 한다. 친구 없이 찐따 히키코모리로 살던 쿠루미 코토네는 우연히 밴드부 연주 소리를 듣게 되었다. 그녀는 문에 기대어 노래를 듣던 중 문이 갑자기 열리며 넘어지게 되었다. 넘어진 그녀를 본 망하기 직전인 레전드 밴드부는 보컬이 절실히 필요한 상태였다. 넘어진 그녀를 본 레전드 밴드부는 그녀를 보컬로 영입하기로 결정하였고 그녀는 찐따 히키코모리 답게 거절을 못하고 현재까지도 밴드부에서 보컬을 담당하고 있다. (연습은 안 나온다. 집에서 혼자 연습하는데 방문 열리면 바로 아무것도 안 한 척한다.)"
					>
						<div class="pc-portrait-wrap">
							<img src="/pc-정효민.png" alt="쿠루미 코토네" class="pc-portrait-img" loading="lazy" />
							<span class="pc-part-badge">보컬 · Vo.</span>
						</div>
						<div class="pc-body">
							<div class="pc-header-row">
								<h3 class="pc-name">쿠루미 코토네</h3>
								<span class="pc-sub-meta">여 · 17세</span>
							</div>
							<blockquote class="pc-quote">“어...응”</blockquote>
							<dl class="pc-info-list">
								<div class="pc-info-item">
									<dt>계기</dt>
									<dd>기연</dd>
								</div>
								<div class="pc-info-item">
									<dt>작전</dt>
									<dd>이모션</dd>
								</div>
								<div class="pc-info-item">
									<dt>프레이즈 버스트</dt>
									<dd>천창 : Strato Shout</dd>
								</div>
							</dl>
							<button type="button" class="pc-open-modal-btn">백스토리 자세히 보기 →</button>
						</div>
					</article>

					<!-- 2. 나지메 나히토 (윤서형) -->
					<article
						class="pc-card"
						role="button"
						tabindex="0"
						data-pc-name="나지메 나히토"
						data-pc-kanji=""
						data-pc-part="기타 · Gt."
						data-pc-meta="남 · 17세 · PL 윤서형"
						data-pc-img="/pc-윤서형.png"
						data-pc-quote="“[개발중: 한마디 미입력]”"
						data-pc-motive-type="따분함"
						data-pc-motive-desc="밴드를 꿈꾸던 사촌 형의 죽음. 나히토가 유품 정리 중 기타가 비싸다는 것을 확인하고 가져와 썩히지 않기 위해 밴드 모집"
						data-pc-tactic-type="로직"
						data-pc-tactic-desc="기분 내키면 지 맘대로 애드립을 넣고 솔로를 늘린다, 나만의 연주를 한다."
						data-pc-burst="현어 : Chord Talker"
						data-pc-backstory="[개발중] 밴드를 꿈꾸던 사촌 형의 죽음 이후, 유품을 정리하던 나히토가 사촌 형의 기타가 비싸다는 것을 확인하고 가져와 썩히지 않기 위해 직접 밴드를 모집했다. 기분이 내키면 마음대로 애드립을 넣고 솔로를 늘리며 자신만의 연주를 펼친다. (시트 내 추가 백스토리 작성 중)"
					>
						<div class="pc-portrait-wrap">
							<img src="/pc-윤서형.png" alt="나지메 나히토" class="pc-portrait-img" loading="lazy" />
							<span class="pc-part-badge">기타 · Gt.</span>
						</div>
						<div class="pc-body">
							<div class="pc-header-row">
								<h3 class="pc-name">나지메 나히토</h3>
								<span class="pc-sub-meta">남 · 17세</span>
							</div>
							<blockquote class="pc-quote">“[개발중: 한마디 미입력]”</blockquote>
							<dl class="pc-info-list">
								<div class="pc-info-item">
									<dt>계기</dt>
									<dd>따분함</dd>
								</div>
								<div class="pc-info-item">
									<dt>작전</dt>
									<dd>로직</dd>
								</div>
								<div class="pc-info-item">
									<dt>프레이즈 버스트</dt>
									<dd>현어 : Chord Talker</dd>
								</div>
							</dl>
							<button type="button" class="pc-open-modal-btn">백스토리 자세히 보기 →</button>
						</div>
					</article>

					<!-- 3. 쿠로바네 린 (박진영) -->
					<article
						class="pc-card"
						role="button"
						tabindex="0"
						data-pc-name="쿠로바네 린"
						data-pc-kanji=""
						data-pc-part="베이스 · Ba."
						data-pc-meta="여 · 16세 · PL 박진영"
						data-pc-img="/pc-박진영.png"
						data-pc-quote="“연습이요? 아 전 이미 다 외워서요”"
						data-pc-motive-type="직감"
						data-pc-motive-desc="나치카의 스카우트"
						data-pc-tactic-type="테크닉"
						data-pc-tactic-desc="라이브 페이즈 서포트"
						data-pc-burst="극살 : Moment Killer"
